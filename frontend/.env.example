# ==================== Mock / Real API Mode ====================
# true → 使用 src/data/mockData.ts 中的模拟数据
# false → 必须调用真实后端 API，失败时显示错误提示
VITE_USE_MOCK=false

# ==================== API Base URL ====================
# 开发环境推荐留空，使用 Vite proxy（/api → http://localhost:8000）
# 如果不使用 proxy，可设置为 http://localhost:8000
VITE_API_BASE_URL=