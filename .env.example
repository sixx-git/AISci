# ============================================================================
# AI Scientist 环境配置文件
# 复制此文件为 .env 并填入实际配置值
# ============================================================================

# ----------------------------------------------------------------------------
# 应用基础配置
# ----------------------------------------------------------------------------
APP_NAME=AI Scientist
DEBUG=True
VERSION=0.1.0

# ----------------------------------------------------------------------------
# 后端服务配置
# ----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----------------------------------------------------------------------------
# 数据库配置
# ----------------------------------------------------------------------------
# SQLite (默认，无需安装额外软件)
DATABASE_URL=sqlite:///./data/aiscientist.db

# MySQL (可选，需要安装 MySQL)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/aiscientist

# PostgreSQL (可选)
# DATABASE_URL=postgresql://user:password@localhost:5432/aiscientist

# ----------------------------------------------------------------------------
# 千问 API 配置 (用于研究功能，可选)
# ----------------------------------------------------------------------------
# 获取 API Key: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# 备选模型: qwen-plus, qwen-turbo

# ----------------------------------------------------------------------------
# Mock LLM 模式
# ----------------------------------------------------------------------------
# 设置为 true 可在没有 QWEN_API_KEY 时跑通完整 Pipeline
# 所有 LLM 调用返回模拟数据，仅用于开发调试
USE_MOCK_LLM=false

# ----------------------------------------------------------------------------
# 向量存储配置
# ----------------------------------------------------------------------------
# Chat 专用 Zvec Collection 目录
VECTOR_STORE_PATH=./storage/chat_vectors
# 项目级 Zvec 向量库目录（文献库 RAG / 文献挖掘 共用）
VECTOR_INDEXES_PATH=./storage/vector_indexes
VECTOR_BACKEND=zvec
# Hugging Face 镜像（sentence_transformers 后端下载模型；留空则走官方源）
HF_ENDPOINT=https://hf-mirror.com
# embedding 后端：sentence_transformers（本地）| qwen（DashScope API，复用 QWEN_API_KEY）
EMBEDDING_BACKEND=sentence_transformers
# qwen 后端推荐 text-embedding-v3 或 text-embedding-v4；本地后端用 HuggingFace 模型名
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 千问 embedding 向量维度（v3/v4 常用 1024；0=模型默认）
EMBEDDING_DIMENSION=0
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ----------------------------------------------------------------------------
# 文件上传配置（大文件支持）
# ----------------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
# 2GB = 2147483648
MAX_UPLOAD_SIZE=2147483648
UPLOAD_CHUNK_SIZE=8388608
LARGE_FILE_THRESHOLD_BYTES=52428800
LARGE_FILE_NO_COPY_BYTES=52428800
DATA_PROBE_SAMPLE_ROWS=1000
SANDBOX_TIMEOUT_T0_SEC=120
SANDBOX_TIMEOUT_T1_SEC=300
SANDBOX_TIMEOUT_T2_SEC=600
# Docker 沙箱（可选，Windows 需 Docker Desktop + 文件共享）
# AISCI_SANDBOX_USE_DOCKER=1
# AISCI_SANDBOX_DOCKER_IMAGE=python:3.11-slim
ALLOWED_EXTENSIONS=txt,pdf,docx,md,csv

# ----------------------------------------------------------------------------
# CORS 配置
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# 日志配置
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
